<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Capture-affinity restoration proof (issue #146): Boo's real screen-capture backend (WindowsFrameCaptureBackend)
    switches each visible Boo-owned window to WDA_EXCLUDEFROMCAPTURE for one frame and must put every one of them back
    to its ORIGINAL display affinity afterwards: on success, on a failed capture, on cancellation, and even when one
    restore fails. The test creates real top-level windows in its own process, drives the real backend and reads the
    real affinity back from Windows with GetWindowDisplayAffinity. Nothing about Boo.exe is launched; no AI, no key.

    Changes window display affinity, so it runs on GitHub-hosted windows-latest only (demo-ci); every test refuses to
    run unless RUNNER_ENVIRONMENT is github-hosted. Lives in tools/, not tests/: tests/** is the frozen oracle.
    Not part of Boo.sln.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Boo.Windows/Boo.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
