<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Boo APP EXPLORER: drives the published Boo.exe like a user (FlaUI) to FIND bugs, not to prove one feature.
    Scripted journeys from .claude/skills/verify-boo/journeys.md (PR #50), then bounded, seeded variations around them:
    wrong-order clicks, rapid hover / hotkey toggles, typing during a pending reply, settings change mid-chat, bad key,
    no network, kill-and-relaunch mid-reply. Every step checks the same health invariants (process alive, no crash log,
    at most one panel, the notch settles, no stuck "Thinking") and writes xNN-*.txt + Boo-window screenshots.

    Runs ONLY on GitHub's windows-latest VM through .github/workflows/app-explorer.yml (workflow_dispatch). Real OpenAI
    calls are capped at 20 per run, counted at Boo's own network boundary by RequestMeter (System.Net.Http events over
    EventPipe); every request Boo sent is listed in explorer-ledger.txt. No retries.

    Lives in tools/, not tests/ (frozen oracle). REUSES the existing harness unchanged by linking it, like
    tools/Boo.VerifyLive does. Not part of Boo.sln. Does not touch PR #54's tools/Boo.QaSuite.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
    <!-- RequestMeter: counts Boo's real HTTP requests from its own System.Net.Http events over EventPipe. -->
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.731102" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Boo.Storage/Boo.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="../../tests/Boo.Demo.Tests/BooAppFixture.cs" Link="Harness/BooAppFixture.cs" />
    <Compile Include="../../tests/Boo.Demo.Tests/OrderedSteps.cs" Link="Harness/OrderedSteps.cs" />
    <Compile Include="../Boo.LiveSmoke/LiveAppFixture.cs" Link="Harness/LiveAppFixture.cs" />
    <Compile Include="../Boo.LiveSmoke/RealAiHostGuard.cs" Link="Harness/RealAiHostGuard.cs" />
    <Content Include="../../tests/Boo.Demo.Tests/xunit.runner.json" Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
