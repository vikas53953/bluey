<Project Sdk="Microsoft.NET.Sdk">
  <!-- BOO-CASS-001 (docs/quality/cassettes.md): replays recorded and hand-made OpenAI replies through Boo's real
       OpenAI client. MOCK evidence only; never a replacement for the live-ai-smoke run. No key, no network. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <ProjectReference Include="../../src/Boo.Core/Boo.Core.csproj" />
    <ProjectReference Include="../../src/Boo.Providers/Boo.Providers.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <None Include="cassettes/*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="cassettes" />
  </ItemGroup>
</Project>
