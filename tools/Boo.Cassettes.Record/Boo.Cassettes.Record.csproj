<Project Sdk="Microsoft.NET.Sdk">
  <!-- BOO-CASS-001 recorder (docs/quality/cassettes.md). Run ONLY by .github/workflows/record-cassettes.yml on a
       GitHub-hosted runner with BOO_LIVE_OPENAI_KEY. Not in Boo.sln; windows-ci builds it so it cannot rot. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Boo.Core/Boo.Core.csproj" />
    <ProjectReference Include="../../src/Boo.Providers/Boo.Providers.csproj" />
    <Compile Include="../Boo.Cassettes.Tests/Cassette.cs" Link="Cassette.cs" />
  </ItemGroup>
</Project>
