<Project Sdk="Microsoft.NET.Sdk">
  <!--
    LIVE user journeys for the verify-boo skill (.claude/skills/verify-boo/SKILL.md): the published Boo.exe driven
    with FlaUI the way a user does, against a REAL AI provider (no mock). Covers notch wake by hotkey and by hover,
    typed chat, screen explain with pointer + ring, research with source links, a permissioned Apply/Undo and a
    25-minute focus session on the existing Developer Mode clock (4x, so about 6.5 real minutes).

    Run by .github/workflows/live-ai-smoke.yml when its `journeys` input is true, or locally by
    .claude/skills/verify-boo/scripts/Invoke-VerifyBoo.ps1 -Suite live (needs BOO_LIVE_OPENAI_KEY in the environment).

    Lives in tools/, not tests/: tests/** is the frozen test oracle and must not grow. It REUSES the harness unchanged
    by linking tests/Boo.Demo.Tests/BooAppFixture.cs (launch, isolated BOO_DATA_DIR, screenshots, Run-key restore) and
    tools/Boo.LiveSmoke/LiveAppFixture.cs (fail-closed key read, DPAPI key seeding, speech off).

    Not part of Boo.sln. Costs money per run (about 45 paid requests, most of them small focus checks).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.731102" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Boo.Storage/Boo.Storage.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="../Boo.Explorer/RequestMeter.cs" Link="Harness/RequestMeter.cs" />
    <Compile Include="../../tests/Boo.Demo.Tests/BooAppFixture.cs" Link="Harness/BooAppFixture.cs" />
    <Compile Include="../../tests/Boo.Demo.Tests/OrderedSteps.cs" Link="Harness/OrderedSteps.cs" />
    <Compile Include="../Boo.LiveSmoke/LiveAppFixture.cs" Link="Harness/LiveAppFixture.cs" />
    <Compile Include="../Boo.LiveSmoke/RealAiHostGuard.cs" Link="Harness/RealAiHostGuard.cs" />
    <Content Include="../../tests/Boo.Demo.Tests/xunit.runner.json" Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
