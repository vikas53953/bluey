<Window x:Class="Boo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Boo companion" Width="1120" Height="780" MinWidth="760" MinHeight="520"
        WindowStartupLocation="Manual" ShowInTaskbar="True" ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow" AllowsTransparency="False" Background="{DynamicResource BooInk}"
        FontFamily="{StaticResource BooFont}"
        KeyDown="Window_OnKeyDown" Loaded="Window_OnLoaded" Closing="Window_OnClosing">
    <Grid x:Name="MainSurface" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="HeaderBody" Width="92" Height="44" VerticalAlignment="Top"
                    CornerRadius="22" Background="{DynamicResource BooNotchBody}">
                <Grid>
                    <Ellipse x:Name="HeaderLeftEye" Width="10" Height="15" Fill="{DynamicResource BooNotchEyes}"
                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="25,0,0,0" />
                    <Ellipse x:Name="HeaderRightEye" Width="10" Height="15" Fill="{DynamicResource BooNotchEyes}"
                             HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,25,0" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <TextBlock Text="Boo" Foreground="{DynamicResource BooText}" FontFamily="{StaticResource BooRounded}"
                           FontSize="{StaticResource BooHeadingSize}" FontWeight="Bold" />
                <TextBlock Text="Screen-side companion" Foreground="{DynamicResource BooMuted}"
                           FontFamily="{StaticResource BooFont}" FontSize="12" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="StopButton" Content="Stop" ToolTip="Stop capture, audio, and pending work"
                        AutomationProperties.Name="Stop Boo" Click="StopButton_OnClick"
                        Style="{StaticResource BooButton}" Background="{DynamicResource BooPanelRaised}" BorderBrush="{DynamicResource BooBorder}" />
                <Button x:Name="CloseButton" Content="×" ToolTip="Hide Boo controls"
                        AutomationProperties.Name="Close Boo controls" Click="CloseButton_OnClick"
                        Style="{StaticResource BooButton}" Padding="9,5" Margin="0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" MinWidth="430" />
                <ColumnDefinition Width="1*" MinWidth="270" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="ConversationScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="0,0,16,0">
                <StackPanel>
                    <Border Background="{DynamicResource BooPanelRaised}" BorderBrush="{DynamicResource BooBorder}"
                            BorderThickness="1" CornerRadius="14" Padding="12,8" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="CaptureDot" Width="10" Height="10" Fill="{DynamicResource BooMuted}" Margin="0,4,8,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="CaptureIndicator" Text="Screen sharing off · display not selected"
                                           Style="{StaticResource BooLabel}" FontSize="13" TextWrapping="Wrap"
                                           AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                                           AutomationProperties.LiveSetting="Polite" />
                                <TextBlock x:Name="CaptureDetail" Visibility="Collapsed" Margin="0,5,0,0"
                                           Foreground="{DynamicResource BooMuted}" FontSize="11" TextWrapping="Wrap"
                                           AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="Ask Boo" Foreground="{DynamicResource BooText}" FontFamily="{StaticResource BooRounded}"
                               FontSize="22" Margin="0,0,0,8" />
                    <TextBox x:Name="InputBox" Style="{StaticResource BooTextBox}" Height="76"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Type a question for Boo" KeyDown="InputBox_OnKeyDown"
                             ToolTip="Type a screen question or a bounded task request" />
                    <WrapPanel Margin="0,0,0,8">
                        <Button x:Name="SendButton" Content="Send" AutomationProperties.Name="Send typed question"
                                Click="SendButton_OnClick" Style="{StaticResource BooButton}" />
                        <Button x:Name="TalkButton" Content="Talk" AutomationProperties.Name="Activate microphone"
                                Click="TalkButton_OnClick" Style="{StaticResource BooButton}" />
                        <CheckBox x:Name="SpeechMute" Content="Mute speech" Foreground="{DynamicResource BooMuted}"
                                  FontFamily="{StaticResource BooFont}" VerticalAlignment="Center" Margin="7,0,0,0"
                                  AutomationProperties.Name="Mute spoken replies" />
                        <CheckBox x:Name="ChirpMute" Content="Mute chirps" Foreground="{DynamicResource BooMuted}"
                                  FontFamily="{StaticResource BooFont}" VerticalAlignment="Center" Margin="9,0,0,0"
                                  AutomationProperties.Name="Mute listening chirps" />
                        <CheckBox x:Name="StartWithWindowsBox" Content="Start Boo with Windows" Foreground="{DynamicResource BooMuted}"
                                  FontFamily="Segoe UI" VerticalAlignment="Center" Margin="9,0,0,0"
                                  AutomationProperties.Name="Start Boo with Windows" />
                    </WrapPanel>
                    <TextBlock x:Name="ListeningStatus" Text="Typing is ready. Microphone starts only after Talk."
                               Foreground="{DynamicResource BooMuted}" FontFamily="{StaticResource BooFont}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,14"
                               AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                               AutomationProperties.LiveSetting="Polite" />

                    <Border Background="{DynamicResource BooPanel}" CornerRadius="16" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Conversation" Foreground="{DynamicResource BooMuted}" FontFamily="{StaticResource BooFont}"
                                       FontSize="12" Margin="0,0,0,7" />
                            <ScrollViewer x:Name="TranscriptScroll" Height="250" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="TranscriptList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,9">
                                                <TextBlock Text="{Binding Speaker}" Foreground="{DynamicResource BooAccent}"
                                                           FontFamily="{StaticResource BooRounded}" FontSize="12" />
                                                <TextBlock Text="{Binding Text}" Foreground="{DynamicResource BooText}"
                                                           FontFamily="{StaticResource BooFont}" FontSize="14" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="Sources" Foreground="{DynamicResource BooMuted}" FontFamily="{StaticResource BooFont}" FontSize="12"
                                       Margin="0,9,0,3" />
                            <StackPanel x:Name="SourceLinksList" />
                            <TextBlock x:Name="SourceStatusText" Visibility="Collapsed" Margin="0,2,0,0"
                                       Foreground="{DynamicResource BooMuted}" FontSize="12" TextWrapping="Wrap"
                                       AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <TextBlock x:Name="AnnotationDetail" Visibility="Collapsed" Margin="0,7,0,0"
                                       Foreground="{DynamicResource BooMuted}" FontSize="12" TextWrapping="Wrap"
                                       AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="ActionPreview" Visibility="Collapsed" Background="{DynamicResource BooPanel}"
                            BorderBrush="{DynamicResource BooBorder}" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Review action" Foreground="{DynamicResource BooAccent}" FontFamily="{StaticResource BooRounded}"
                                       FontSize="18" />
                            <TextBlock x:Name="ActionPreviewText" Foreground="{DynamicResource BooText}" FontFamily="{StaticResource BooFont}"
                                       TextWrapping="Wrap" Margin="0,5,0,10" />
                            <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Requested target" Style="{StaticResource BooLabel}" />
                                    <TextBox Text="{Binding RequestedTarget, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                             Style="{StaticResource BooTextBox}" AutomationProperties.Name="Requested target" />
                                    <TextBlock Text="Resolved destination" Style="{StaticResource BooLabel}" />
                                    <TextBox Text="{Binding Destination, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                             Style="{StaticResource BooTextBox}" AutomationProperties.Name="Resolved destination" />
                                    <ItemsControl ItemsSource="{Binding Fields}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource BooLabel}" />
                                                    <TextBox Text="{Binding DisplayValue, Mode=OneWay}" IsReadOnly="True"
                                                             TextWrapping="Wrap" Style="{StaticResource BooTextBox}"
                                                             AutomationProperties.Name="{Binding Label}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                            <TextBlock x:Name="ActionBlockedReason" Visibility="Collapsed" Foreground="{DynamicResource BooAccent}"
                                       TextWrapping="Wrap" Margin="0,0,0,10"
                                       AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                                       AutomationProperties.LiveSetting="Polite" />
                            <WrapPanel>
                                <Button x:Name="CancelButton" Content="_Cancel" ToolTip="Cancel proposed action (Alt+C)"
                                        AutomationProperties.Name="Cancel proposed action" Click="CancelButton_OnClick"
                                        Style="{StaticResource BooButton}" IsCancel="True" />
                                <Button x:Name="ApproveButton" Content="_Approve" ToolTip="Approve proposed action (Alt+A)"
                                        AutomationProperties.Name="Approve proposed action" Click="ApproveButton_OnClick"
                                        Style="{StaticResource BooButton}" Background="{DynamicResource BooPanelRaised}"
                                        BorderBrush="{DynamicResource BooAccent}" IsDefault="False" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SecondaryScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Background="{DynamicResource BooPanel}" CornerRadius="16" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Focus" Foreground="{DynamicResource BooText}" FontFamily="{StaticResource BooRounded}"
                                       FontSize="20" Margin="0,0,0,5" />
                            <TextBlock Text="Boo observes periodically and never clicks, closes, or blocks your apps."
                                       Foreground="{DynamicResource BooMuted}" FontFamily="{StaticResource BooFont}" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,0,0,10" />
                            <TextBox x:Name="FocusTaskBox" Style="{StaticResource BooTextBox}" Height="34"
                                     ToolTip="What are you focusing on?" AutomationProperties.Name="Focus task" />
                            <WrapPanel Margin="0,0,0,7">
                                <TextBox x:Name="FocusDurationBox" Text="30" Width="70" Height="34" Style="{StaticResource BooTextBox}"
                                         ToolTip="Duration in minutes" AutomationProperties.Name="Focus duration in minutes" />
                                <TextBlock Text="minutes" Foreground="{DynamicResource BooMuted}" VerticalAlignment="Center" Margin="3,0,12,8" />
                                <TextBlock x:Name="FocusTimer" Text="Not running" Foreground="{DynamicResource BooText}"
                                           FontFamily="{StaticResource BooRounded}" FontSize="18" VerticalAlignment="Center" />
                            </WrapPanel>
                            <WrapPanel>
                                <Button x:Name="FocusStartButton" Content="Start" AutomationProperties.Name="Start focus session"
                                        Click="FocusStartButton_OnClick" Style="{StaticResource BooButton}" />
                                <Button x:Name="FocusPauseButton" Content="Pause" AutomationProperties.Name="Pause focus session"
                                        Click="FocusPauseButton_OnClick" Style="{StaticResource BooButton}" />
                                <Button x:Name="FocusResumeButton" Content="Resume" AutomationProperties.Name="Resume focus session"
                                        Click="FocusResumeButton_OnClick" Style="{StaticResource BooButton}" />
                                <Button x:Name="FocusEndButton" Content="End" AutomationProperties.Name="End focus session"
                                        Click="FocusEndButton_OnClick" Style="{StaticResource BooButton}" />
                            </WrapPanel>
                            <TextBlock x:Name="FocusStatus" Text="No focus session" Foreground="{DynamicResource BooMuted}"
                                       FontFamily="{StaticResource BooFont}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" />
                            <CheckBox x:Name="DeveloperModeBox" Content="Developer Mode" Foreground="{DynamicResource BooMuted}"
                                      Margin="0,8,0,0" AutomationProperties.Name="Developer Mode"
                                      ToolTip="Runs the focus clock 4x and checks every 10 seconds, for testing"
                                      Checked="DeveloperModeBox_OnChanged" Unchecked="DeveloperModeBox_OnChanged" />
                            <TextBlock x:Name="DeveloperModeStatus" Text="Developer Mode off: real-time clock, checks every 30 seconds."
                                       Foreground="{DynamicResource BooMuted}" FontFamily="{StaticResource BooFont}" FontSize="10" TextWrapping="Wrap"
                                       Margin="0,2,0,0" AutomationProperties.Name="Developer Mode status" />
                            <Border Background="{DynamicResource BooPanelRaised}" CornerRadius="10" Padding="9" Margin="0,9,0,0">
                                <StackPanel>
                                    <WrapPanel>
                                        <TextBlock Text="Session history" Foreground="{DynamicResource BooText}"
                                                   FontFamily="{StaticResource BooRounded}" FontSize="14" />
                                        <Button x:Name="RefreshHistoryButton" Content="Refresh"
                                                AutomationProperties.Name="Refresh focus history" Click="RefreshHistoryButton_OnClick"
                                                Style="{StaticResource BooButton}" FontSize="11" Padding="8,4" Margin="10,0,0,0" />
                                    </WrapPanel>
                                    <ItemsControl x:Name="HistoryList" Margin="0,6,0,0" AutomationProperties.Name="Focus history timeline">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,9" AutomationProperties.Name="{Binding Title}"
                                                            AutomationProperties.HelpText="{Binding Detail}">
                                                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource BooText}"
                                                               FontFamily="{StaticResource BooRounded}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource BooMuted}"
                                                               FontFamily="{StaticResource BooFont}" FontSize="10" Margin="0,1,0,3" />
                                                    <Border Width="260" Height="8" CornerRadius="4" HorizontalAlignment="Left"
                                                            Background="{DynamicResource BooInk}" ClipToBounds="True">
                                                        <ItemsControl ItemsSource="{Binding Bars}" Focusable="False">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <Canvas />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemContainerStyle>
                                                                <Style TargetType="ContentPresenter">
                                                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                                </Style>
                                                            </ItemsControl.ItemContainerStyle>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Rectangle Width="{Binding Width}" Height="8">
                                                                        <Rectangle.Style>
                                                                            <Style TargetType="Rectangle">
                                                                                <Setter Property="Fill" Value="{DynamicResource BooBorder}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Kind}" Value="OnTask">
                                                                                        <Setter Property="Fill" Value="{DynamicResource BooText}" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Kind}" Value="OffTask">
                                                                                        <Setter Property="Fill" Value="{DynamicResource BooDanger}" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Kind}" Value="Uncertain">
                                                                                        <Setter Property="Fill" Value="{DynamicResource BooMuted}" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Kind}" Value="Paused">
                                                                                        <Setter Property="Fill" Value="{DynamicResource BooAccent}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Rectangle.Style>
                                                                    </Rectangle>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Light: on task · Red: off task · Light grey: uncertain · Peach tick: pause · Dark grey: not observed"
                                               Foreground="{DynamicResource BooMuted}" FontFamily="Segoe UI" FontSize="10"
                                               TextWrapping="Wrap" Margin="0,0,0,3" />
                                    <TextBlock x:Name="HistoryStatus" Text="Periodic observations are estimates, not an exact time audit."
                                               Foreground="{DynamicResource BooMuted}" FontFamily="{StaticResource BooFont}" FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SettingsSection" Background="{DynamicResource BooPanel}" CornerRadius="16" Padding="14" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Settings" Foreground="{DynamicResource BooText}" FontFamily="{StaticResource BooRounded}"
                                       FontSize="20" Margin="0,0,0,7" />
                            <TextBlock x:Name="ShortcutStatusText" Visibility="Collapsed" Foreground="{DynamicResource BooDanger}"
                                       FontFamily="{StaticResource BooFont}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                       AutomationProperties.AutomationId="ShortcutStatusText"
                                       AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <TextBlock Text="Display" Foreground="{DynamicResource BooMuted}" FontFamily="{StaticResource BooFont}" FontSize="12" />
                            <ComboBox x:Name="DisplayBox" Height="34" Margin="0,3,0,8" AutomationProperties.Name="Selected display"
                                      SelectionChanged="DisplayBox_OnSelectionChanged" />
                            <TextBlock Text="Notch offset" Foreground="{DynamicResource BooMuted}" FontFamily="{StaticResource BooFont}" FontSize="12" />
                            <Slider x:Name="OffsetSlider" Minimum="-30" Maximum="120" Value="0" TickFrequency="5" IsSnapToTickEnabled="True"
                                    AutomationProperties.Name="Notch vertical offset" />
                            <TextBlock Text="Task folder" Foreground="{DynamicResource BooMuted}" FontFamily="{StaticResource BooFont}" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,8">
                                <TextBox x:Name="FileRootBox" Width="185" Height="30" Style="{StaticResource BooTextBox}"
                                         AutomationProperties.Name="Selected task folder" ToolTip="Boo can only operate inside this user-selected folder" />
                                <Button x:Name="BrowseFolderButton" Content="Choose" AutomationProperties.Name="Choose task folder"
                                        Click="BrowseFolderButton_OnClick" Style="{StaticResource BooButton}" FontSize="11" Padding="8,4" Margin="7,0,0,0" />
                            </StackPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <CheckBox x:Name="ReducedMotionBox" Content="Reduced motion" Foreground="{DynamicResource BooMuted}"
                                          AutomationProperties.Name="Reduce motion" />
                                <TextBlock Text="Microphone" Foreground="{DynamicResource BooMuted}" FontFamily="{StaticResource BooFont}" FontSize="11"
                                           VerticalAlignment="Center" Margin="16,0,5,0" />
                                <ComboBox x:Name="MicrophoneBox" Width="108" Height="28" AutomationProperties.Name="Selected microphone" />
                            </WrapPanel>
                            <TextBlock x:Name="VoiceLatencyText" Text="Voice latency: no warm hold-to-talk turns yet."
                                       Foreground="{DynamicResource BooMuted}" FontFamily="Segoe UI" FontSize="10" TextWrapping="Wrap"
                                       Margin="0,0,0,8" AutomationProperties.Name="Voice latency diagnostics" />

                            <TextBlock Text="Appearance" Style="{StaticResource BooLabel}" Margin="0,6,0,5" />
                            <TextBlock Text="Body color (#RRGGBB)" Foreground="{DynamicResource BooMuted}" FontSize="11" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,5">
                                <TextBox x:Name="BodyColorBox" Width="120" Height="30" Style="{StaticResource BooTextBox}"
                                         AutomationProperties.Name="Notch body color" />
                                <Button x:Name="BodyColorButton" Content="Choose" AutomationProperties.Name="Choose notch body color"
                                        Click="BodyColorButton_OnClick" Style="{StaticResource BooButton}" FontSize="11" Padding="8,4" Margin="7,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="Eye color (#RRGGBB)" Foreground="{DynamicResource BooMuted}" FontSize="11" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,5">
                                <TextBox x:Name="EyeColorBox" Width="120" Height="30" Style="{StaticResource BooTextBox}"
                                         AutomationProperties.Name="Notch eye color" />
                                <Button x:Name="EyeColorButton" Content="Choose" AutomationProperties.Name="Choose notch eye color"
                                        Click="EyeColorButton_OnClick" Style="{StaticResource BooButton}" FontSize="11" Padding="8,4" Margin="7,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="AppearanceValidationText" Visibility="Collapsed" Foreground="{DynamicResource BooDanger}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7"
                                       AutomationProperties.LiveSetting="Polite" />
                            <WrapPanel Margin="0,0,0,8">
                                <Button x:Name="SaveSettingsButton" Content="_Save settings" ToolTip="Save Boo settings (Alt+S)" AutomationProperties.Name="Save Boo settings"
                                        Click="SaveSettingsButton_OnClick" Style="{StaticResource BooButton}" />
                                <Button x:Name="ResetAppearanceButton" Content="_Reset appearance" ToolTip="Reset notch appearance (Alt+R)" AutomationProperties.Name="Reset notch appearance"
                                        Click="ResetAppearanceButton_OnClick" Style="{StaticResource BooButton}" />
                            </WrapPanel>
                            <TextBlock Text="Protected credential" Foreground="{DynamicResource BooMuted}" FontFamily="{StaticResource BooFont}" FontSize="11" />
                            <PasswordBox x:Name="CredentialBox" Height="28" Margin="0,3,0,8" AutomationProperties.Name="Provider credential masked input" />
                            <TextBlock Text="Screenshots and microphone audio are memory-only by default. Provider processing is separate from local retention."
                                       Foreground="{DynamicResource BooMuted}" FontFamily="{StaticResource BooFont}" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="StatusText" Text="Ready" Foreground="{DynamicResource BooMuted}"
                   FontFamily="{StaticResource BooFont}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"
                   AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                   AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Window>
