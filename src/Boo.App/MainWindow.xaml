<Window x:Class="Boo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Boo.App.Controls"
        Title="Boo companion" Width="420" Height="330" MinWidth="420" MinHeight="330"
        WindowStartupLocation="Manual" ShowInTaskbar="False" ResizeMode="CanResize" Topmost="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource BooFont}"
        KeyDown="Window_OnKeyDown" PreviewKeyDown="Window_OnPreviewKeyDown" Loaded="Window_OnLoaded" Closing="Window_OnClosing"
        MouseEnter="Panel_OnMouseEnter" MouseLeave="Panel_OnMouseLeave" Deactivated="Panel_OnDeactivated">
    <!--
        The hanging panel (round 3, 22 Nov 2026): one dark sheet that drops from the top edge under the notch, like
        HeyClicky's, with exactly three views: Home, Chat, Settings. The notch stays eyes-only; the panel's top bar
        leaves its centre empty so the real eyes sit over it. Every control keeps its AutomationId: the UI smoke
        tests find them after switching to the view that holds them (BooAppFixture.ShowView). "Open in a window"
        turns the same window into a movable, resizable chat (PanelMode.Windowed).
    -->
    <Grid x:Name="MainSurface">
        <Border x:Name="PanelShell" Background="{DynamicResource BooSheet}" BorderBrush="{DynamicResource BooCardBorder}" BorderThickness="1,0,1,1"
                CornerRadius="0,0,18,18" SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top bar: view pill (Home, Chat) on the left, gear / Stop / Close on the right, nothing in the middle. -->
                <Grid x:Name="TopBar" Grid.Row="0" Margin="10,8,10,0" Background="Transparent"
                      MouseLeftButtonDown="TopBar_OnMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ViewPill" Background="{DynamicResource BooPill}" CornerRadius="14" Padding="3" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="HomeTabButton" Style="{StaticResource BooTabButton}" Click="HomeTab_OnClick"
                                    AutomationProperties.Name="Home" ToolTip="Home (Ctrl+1)">
                                <Path Data="M3 10 L10 3 L17 10 M5 9 V17 H15 V9" Stroke="{DynamicResource BooText}" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20" />
                            </Button>
                            <Button x:Name="ChatTabButton" Style="{StaticResource BooTabButton}" Click="ChatTab_OnClick"
                                    AutomationProperties.Name="Chat" ToolTip="Chat (Ctrl+2)">
                                <Path Data="M4 4 H16 A2 2 0 0 1 18 6 V12 A2 2 0 0 1 16 14 H9 L5 17 V14 H4 A2 2 0 0 1 2 12 V6 A2 2 0 0 1 4 4 Z"
                                      Stroke="{DynamicResource BooText}" StrokeThickness="1.6" StrokeLineJoin="Round" Width="20" Height="20" />
                            </Button>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="SettingsTabButton" Style="{StaticResource BooTabButton}" Click="SettingsTab_OnClick"
                                AutomationProperties.Name="Settings" ToolTip="Settings (Ctrl+3)" Margin="0,0,4,0">
                            <Path Data="M10 6.5 A3.5 3.5 0 1 0 10 13.5 A3.5 3.5 0 1 0 10 6.5 Z M10 1.5 V4 M10 16 V18.5 M1.5 10 H4 M16 10 H18.5 M4 4 L5.8 5.8 M14.2 14.2 L16 16 M4 16 L5.8 14.2 M14.2 5.8 L16 4"
                                  Stroke="{DynamicResource BooText}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20" />
                        </Button>
                        <Button x:Name="StopButton" Style="{StaticResource BooTabButton}" Click="StopButton_OnClick"
                                ToolTip="Stop capture, audio, and pending work" AutomationProperties.Name="Stop Boo" Margin="0,0,4,0">
                            <Border Width="11" Height="11" CornerRadius="2" Background="{DynamicResource BooDanger}" />
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource BooTabButton}" Click="CloseButton_OnClick"
                                ToolTip="Hide Boo controls" AutomationProperties.Name="Close Boo controls">
                            <Path Data="M5 5 L15 15 M15 5 L5 15" Stroke="{DynamicResource BooText}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="14,10,14,8">
                    <!-- ============================================================ Home -->
                    <Grid x:Name="HomeView">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="4,0,4,8">
                            <TextBlock x:Name="TitleHeading" Text="Boo" Foreground="{DynamicResource BooText}" FontFamily="{StaticResource BooRounded}"
                                       FontSize="11" FontWeight="SemiBold" Opacity="0.55" AutomationProperties.HeadingLevel="Level1" />
                            <TextBlock x:Name="HomeGreeting" Text="Good evening." Foreground="{DynamicResource BooText}"
                                       FontFamily="{StaticResource BooRounded}" FontSize="22" FontWeight="SemiBold"
                                       AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <TextBlock x:Name="HomeHint" Text="Hold Ctrl+Alt+Space anywhere and just talk, or open Chat."
                                       Foreground="{DynamicResource BooMuted}" FontFamily="{StaticResource BooFont}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <ScrollViewer x:Name="HomeScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <!-- Home card: the focus session (Boo's one job). -->
                                <controls:BooSection x:Name="FocusSection" AutomationProperties.Name="Focus" Background="{DynamicResource BooCard}"
                                                     BorderBrush="{DynamicResource BooCardBorder}" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="FocusHeading" Text="Focus" Foreground="{DynamicResource BooText}" FontFamily="{StaticResource BooRounded}"
                                                       FontSize="17" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
                                            <TextBlock x:Name="FocusTimer" Grid.Column="1" Text="Not running" Foreground="{DynamicResource BooAccent}"
                                                       FontFamily="{StaticResource BooRounded}" FontSize="15" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="Boo looks in now and then and never clicks, closes, or blocks your apps."
                                                   Foreground="{DynamicResource BooMuted}" FontFamily="{StaticResource BooFont}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,2,0,8" />
                                        <TextBox x:Name="FocusTaskBox" Style="{StaticResource BooTextBox}" Height="32"
                                                 ToolTip="What are you focusing on?" AutomationProperties.Name="Focus task" />
                                        <WrapPanel Margin="0,0,0,4">
                                            <TextBox x:Name="FocusDurationBox" Text="30" Width="56" Height="30" Style="{StaticResource BooTextBox}"
                                                     ToolTip="Duration in minutes" AutomationProperties.Name="Focus duration in minutes" Margin="0,0,0,6" />
                                            <TextBlock Text="min" Foreground="{DynamicResource BooMuted}" VerticalAlignment="Center" Margin="4,0,10,6" />
                                            <Button x:Name="FocusStartButton" Content="Start now" AutomationProperties.Name="Start focus session"
                                                    Click="FocusStartButton_OnClick" Style="{StaticResource BooPrimaryButton}" />
                                            <Button x:Name="FocusPauseButton" Content="Pause" AutomationProperties.Name="Pause focus session"
                                                    Click="FocusPauseButton_OnClick" Style="{StaticResource BooButton}" />
                                            <Button x:Name="FocusResumeButton" Content="Resume" AutomationProperties.Name="Resume focus session"
                                                    Click="FocusResumeButton_OnClick" Style="{StaticResource BooButton}" />
                                            <Button x:Name="FocusEndButton" Content="End" AutomationProperties.Name="End focus session"
                                                    Click="FocusEndButton_OnClick" Style="{StaticResource BooButton}" />
                                        </WrapPanel>
                                        <TextBlock x:Name="FocusStatus" Text="No focus session" Foreground="{DynamicResource BooMuted}"
                                                   FontFamily="{StaticResource BooFont}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                                                   AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                                                   AutomationProperties.LiveSetting="Polite" />
                                        <CheckBox x:Name="DeveloperModeBox" Content="Developer Mode" Foreground="{DynamicResource BooMuted}"
                                                  Margin="0,6,0,0" AutomationProperties.Name="Developer Mode"
                                                  ToolTip="Runs the focus clock 4x and checks every 10 seconds, for testing"
                                                  Checked="DeveloperModeBox_OnChanged" Unchecked="DeveloperModeBox_OnChanged" />
                                        <TextBlock x:Name="DeveloperModeStatus" Text="Developer Mode off: real-time clock, checks every 30 seconds."
                                                   Foreground="{DynamicResource BooMuted}" FontFamily="{StaticResource BooFont}" FontSize="10" TextWrapping="Wrap"
                                                   Margin="0,2,0,0" AutomationProperties.Name="Developer Mode status" />
                                    </StackPanel>
                                </controls:BooSection>

                                <!-- Recent sessions (HeyClicky fans these out beside the panel; Boo lists them under the card). -->
                                <controls:BooSection x:Name="HistorySection" AutomationProperties.Name="Session history"
                                                     Background="{DynamicResource BooCard}" BorderBrush="{DynamicResource BooCardBorder}" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,0,4">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="HistoryHeading" Text="Session history" Foreground="{DynamicResource BooText}"
                                                       FontFamily="{StaticResource BooRounded}" FontSize="14" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level3" />
                                            <Button x:Name="RefreshHistoryButton" Grid.Column="1" Content="Refresh"
                                                    AutomationProperties.Name="Refresh focus history" Click="RefreshHistoryButton_OnClick"
                                                    Style="{StaticResource BooButton}" FontSize="11" Padding="8,3" Margin="0" />
                                        </Grid>
                                        <ItemsControl x:Name="HistoryList" Margin="0,6,0,0" AutomationProperties.Name="Focus history timeline">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,9" AutomationProperties.Name="{Binding Title}"
                                                                AutomationProperties.HelpText="{Binding Detail}">
                                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource BooText}"
                                                                   FontFamily="{StaticResource BooRounded}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource BooMuted}"
                                                                   FontFamily="{StaticResource BooFont}" FontSize="10" Margin="0,1,0,3" />
                                                        <Border Width="260" Height="8" CornerRadius="4" HorizontalAlignment="Left"
                                                                Background="{DynamicResource BooInk}" ClipToBounds="True">
                                                            <ItemsControl ItemsSource="{Binding Bars}" Focusable="False">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <Canvas />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemContainerStyle>
                                                                    <Style TargetType="ContentPresenter">
                                                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                                    </Style>
                                                                </ItemsControl.ItemContainerStyle>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Rectangle Width="{Binding Width}" Height="8">
                                                                            <Rectangle.Style>
                                                                                <Style TargetType="Rectangle">
                                                                                    <Setter Property="Fill" Value="{DynamicResource BooBorder}" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Kind}" Value="OnTask">
                                                                                            <Setter Property="Fill" Value="{DynamicResource BooText}" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Kind}" Value="OffTask">
                                                                                            <Setter Property="Fill" Value="{DynamicResource BooDanger}" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Kind}" Value="Uncertain">
                                                                                            <Setter Property="Fill" Value="{DynamicResource BooMuted}" />
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Kind}" Value="Paused">
                                                                                            <Setter Property="Fill" Value="{DynamicResource BooAccent}" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Rectangle.Style>
                                                                        </Rectangle>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Light: on task · Red: off task · Light grey: uncertain · Peach tick: pause · Dark grey: not observed"
                                                   Foreground="{DynamicResource BooMuted}" FontFamily="Segoe UI" FontSize="10"
                                                   TextWrapping="Wrap" Margin="0,0,0,3" />
                                        <TextBlock x:Name="HistoryStatus" Text="Periodic observations are estimates, not an exact time audit."
                                                   Foreground="{DynamicResource BooMuted}" FontFamily="{StaticResource BooFont}" FontSize="10" TextWrapping="Wrap" />
                                    </StackPanel>
                                </controls:BooSection>
                            </StackPanel>
                        </ScrollViewer>
                        <!-- Footer: where HeyClicky keeps Invite / refresh / Apps, Boo keeps the two things it has. -->
                        <Grid Grid.Row="2" Margin="2,6,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="HomeHistoryButton" Content="History" Style="{StaticResource BooButton}" FontSize="11" Padding="9,3"
                                    AutomationProperties.Name="Show session history" Click="HomeHistoryButton_OnClick" />
                            <Button x:Name="HomeChatButton" Grid.Column="2" Content="Ask Boo" Style="{StaticResource BooPrimaryButton}" FontSize="11" Padding="10,3" Margin="0"
                                    AutomationProperties.Name="Open chat" Click="ChatTab_OnClick" />
                        </Grid>
                    </Grid>

                    <!-- ============================================================ Chat -->
                    <Grid x:Name="ChatView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <controls:BooSection x:Name="CaptureCard" Grid.Row="0" AutomationProperties.Name="Screen sharing status"
                                             Background="{DynamicResource BooCard}" BorderBrush="{DynamicResource BooCardBorder}" BorderThickness="1" CornerRadius="10" Padding="10,5" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="CaptureDot" Width="8" Height="8" Fill="{DynamicResource BooMuted}" Margin="0,4,8,0" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="CaptureIndicator" Text="Screen sharing off · display not selected"
                                               Style="{StaticResource BooLabel}" FontSize="11" TextWrapping="Wrap"
                                               AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                                               AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock x:Name="CaptureDetail" Visibility="Collapsed" Margin="0,3,0,0"
                                               Foreground="{DynamicResource BooMuted}" FontSize="10" TextWrapping="Wrap"
                                               AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                                               AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Grid>
                        </controls:BooSection>

                        <controls:BooSection x:Name="ConversationSection" Grid.Row="1" AutomationProperties.Name="Conversation"
                                             Background="Transparent" Padding="0" Margin="0,0,0,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="ConversationHeading" Text="Conversation" Foreground="{DynamicResource BooMuted}" FontFamily="{StaticResource BooFont}"
                                           FontSize="11" Margin="2,0,0,4" AutomationProperties.HeadingLevel="Level2" />
                                <!-- A ListBox, not an ItemsControl: one Tab stop, Up/Down walk the entries, and each entry is a
                                     UIA ListItem named "Speaker: text" so a screen reader can read the conversation back.
                                     Rows are chat bubbles: Boo on the left in grey, You on the right in cream. -->
                                <ListBox x:Name="TranscriptList" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0"
                                         AutomationProperties.Name="Conversation transcript"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         KeyboardNavigation.TabNavigation="Once" SelectionMode="Single"
                                         VirtualizingPanel.IsVirtualizing="False" ScrollViewer.CanContentScroll="False">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="{x:Type ListBoxItem}">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,6" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="AutomationProperties.Name">
                                                <Setter.Value>
                                                    <MultiBinding StringFormat="{}{0}: {1}">
                                                        <Binding Path="Speaker" />
                                                        <Binding Path="Text" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                        <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="14"
                                                                BorderThickness="2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource BooCard}" />
                                                            </Trigger>
                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource BooAccent}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Bubble" CornerRadius="14,14,14,4" Padding="11,7" MaxWidth="300"
                                                    HorizontalAlignment="Left" Background="{DynamicResource BooPanelRaised}">
                                                <StackPanel>
                                                    <TextBlock x:Name="SpeakerLabel" Text="{Binding Speaker}" Foreground="{DynamicResource BooAccent}"
                                                               FontFamily="{StaticResource BooRounded}" FontSize="10" Margin="0,0,0,1" />
                                                    <TextBlock x:Name="BubbleText" Text="{Binding Text}" Foreground="{DynamicResource BooText}"
                                                               FontFamily="{StaticResource BooFont}" FontSize="13" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Speaker}" Value="You">
                                                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource BooBubbleYou}" />
                                                    <Setter TargetName="Bubble" Property="CornerRadius" Value="14,14,4,14" />
                                                    <Setter TargetName="BubbleText" Property="Foreground" Value="{DynamicResource BooBubbleYouText}" />
                                                    <Setter TargetName="SpeakerLabel" Property="Foreground" Value="{DynamicResource BooBubbleYouMuted}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="2">
                                    <TextBlock x:Name="SourcesLabel" Text="Sources" Foreground="{DynamicResource BooMuted}" FontFamily="{StaticResource BooFont}" FontSize="11"
                                               Margin="2,4,0,2" Visibility="Collapsed" />
                                    <StackPanel x:Name="SourceLinksList" />
                                    <TextBlock x:Name="SourceStatusText" Visibility="Collapsed" Margin="2,2,0,0"
                                               Foreground="{DynamicResource BooMuted}" FontSize="11" TextWrapping="Wrap"
                                               AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    <TextBlock x:Name="AnnotationDetail" Visibility="Collapsed" Margin="2,4,0,0"
                                               Foreground="{DynamicResource BooMuted}" FontSize="11" TextWrapping="Wrap"
                                               AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                                               AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Grid>
                        </controls:BooSection>

                        <!-- Review action: an inline card above the composer while an action waits for Approve. -->
                        <controls:BooSection x:Name="ActionPreview" Grid.Row="2" Visibility="Collapsed" AutomationProperties.Name="Review action"
                                             Background="{DynamicResource BooCard}" BorderBrush="{DynamicResource BooAccent}" BorderThickness="1" CornerRadius="14" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock x:Name="ReviewHeading" Text="Review action" Foreground="{DynamicResource BooAccent}" FontFamily="{StaticResource BooRounded}"
                                           FontSize="14" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
                                <TextBlock x:Name="ActionPreviewText" Foreground="{DynamicResource BooText}" FontFamily="{StaticResource BooFont}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,3,0,6"
                                           AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                                           AutomationProperties.LiveSetting="Assertive" />
                                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="Requested target" Style="{StaticResource BooLabel}" FontSize="11" />
                                        <TextBox Text="{Binding RequestedTarget, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                 Style="{StaticResource BooTextBox}" FontSize="12" Padding="8,5" AutomationProperties.Name="Requested target" />
                                        <TextBlock Text="Resolved destination" Style="{StaticResource BooLabel}" FontSize="11" />
                                        <TextBox Text="{Binding Destination, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                 Style="{StaticResource BooTextBox}" FontSize="12" Padding="8,5" AutomationProperties.Name="Resolved destination" />
                                        <ItemsControl ItemsSource="{Binding Fields}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" Style="{StaticResource BooLabel}" FontSize="11" />
                                                        <TextBox Text="{Binding DisplayValue, Mode=OneWay}" IsReadOnly="True"
                                                                 TextWrapping="Wrap" Style="{StaticResource BooTextBox}" FontSize="12" Padding="8,5"
                                                                 AutomationProperties.Name="{Binding Label}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                                <TextBlock x:Name="ActionBlockedReason" Visibility="Collapsed" Foreground="{DynamicResource BooAccent}"
                                           FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                                           AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                                           AutomationProperties.LiveSetting="Polite" />
                                <WrapPanel>
                                    <Button x:Name="CancelButton" Content="_Cancel" ToolTip="Cancel proposed action (Alt+C)"
                                            AutomationProperties.Name="Cancel proposed action" Click="CancelButton_OnClick"
                                            Style="{StaticResource BooButton}" IsCancel="True" />
                                    <Button x:Name="ApproveButton" Content="_Approve" ToolTip="Approve proposed action (Alt+A)"
                                            AutomationProperties.Name="Approve proposed action" Click="ApproveButton_OnClick"
                                            Style="{StaticResource BooPrimaryButton}" IsDefault="False" />
                                </WrapPanel>
                            </StackPanel>
                        </controls:BooSection>

                        <!-- Composer: the text box, Send, the big Talk pill, and the way out to a real window. -->
                        <controls:BooSection x:Name="AskSection" Grid.Row="3" AutomationProperties.Name="Ask Boo"
                                             Background="Transparent" Padding="0" Margin="0">
                            <StackPanel>
                                <TextBlock x:Name="AskHeading" Text="Ask Boo" Foreground="{DynamicResource BooMuted}" FontFamily="{StaticResource BooRounded}"
                                           FontSize="11" Margin="2,0,0,4" AutomationProperties.HeadingLevel="Level2" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Margin="0,0,6,0">
                                        <TextBox x:Name="InputBox" Style="{StaticResource BooTextBox}" MinHeight="36" MaxHeight="96" Margin="0"
                                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10,8,10,8"
                                                 AutomationProperties.Name="Type a question for Boo" KeyDown="InputBox_OnKeyDown"
                                                 TextChanged="InputBox_OnTextChanged"
                                                 ToolTip="Type a screen question or a bounded task request. Ctrl+Enter sends; F6 moves between Chat, Home and Settings."
                                                 AutomationProperties.HelpText="Ctrl+Enter sends. F6 moves between Chat, Home and Settings." />
                                        <TextBlock x:Name="InputPlaceholder" Text="Ask Boo…" Foreground="{DynamicResource BooMuted}" FontSize="13"
                                                   Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                    </Grid>
                                    <Button x:Name="SendButton" Grid.Column="1" AutomationProperties.Name="Send typed question" ToolTip="Send (Ctrl+Enter)"
                                            Click="SendButton_OnClick" Style="{StaticResource BooButton}" Padding="9,0" Height="36" Margin="0,0,6,0">
                                        <Path Data="M3 10 H16 M11 5 L16 10 L11 15" Stroke="{DynamicResource BooText}" StrokeThickness="1.8"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="20" Height="20" />
                                    </Button>
                                    <Button x:Name="TalkButton" Grid.Column="2" AutomationProperties.Name="Activate microphone"
                                            ToolTip="Talk to Boo (or hold Ctrl+Alt+Space anywhere)" Click="TalkButton_OnClick"
                                            Style="{StaticResource BooPrimaryButton}" Height="36" Padding="12,0" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M10 3 A2.5 2.5 0 0 1 12.5 5.5 V10 A2.5 2.5 0 0 1 7.5 10 V5.5 A2.5 2.5 0 0 1 10 3 Z M5 9.5 A5 5 0 0 0 15 9.5 M10 14.5 V17"
                                                  Stroke="{DynamicResource BooBubbleYouText}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="20" Height="20" Margin="0,0,5,0" />
                                            <TextBlock Text="Talk" VerticalAlignment="Center" FontFamily="{StaticResource BooRounded}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BooBubbleYouText}" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="OpenInWindowButton" Grid.Column="3" AutomationProperties.Name="Open chat in a window"
                                            ToolTip="Open in a window (move and resize; press again to dock it back under the notch)"
                                            Click="OpenInWindowButton_OnClick" Style="{StaticResource BooButton}" Padding="8,0" Height="36" Margin="0">
                                        <Path Data="M8 4 H4 V16 H16 V12 M11 4 H16 V9 M16 4 L9 11" Stroke="{DynamicResource BooText}" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="20" Height="20" />
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="ListeningStatus" Text="Typing is ready. Microphone starts only after Talk."
                                           Foreground="{DynamicResource BooMuted}" FontFamily="{StaticResource BooFont}" FontSize="11"
                                           TextWrapping="Wrap" Margin="2,5,0,0"
                                           AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </controls:BooSection>
                    </Grid>

                    <!-- ============================================================ Settings -->
                    <Grid x:Name="SettingsView" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Sidebar: one entry per group; a click scrolls the page to that group. -->
                        <StackPanel x:Name="SettingsNav" Grid.Column="0" Margin="0,2,10,0">
                            <Button Content="General" Tag="SettingsGeneralHeading" Style="{StaticResource BooNavButton}" Click="SettingsNav_OnClick" AutomationProperties.Name="General settings" />
                            <Button Content="Voice" Tag="SettingsVoiceHeading" Style="{StaticResource BooNavButton}" Click="SettingsNav_OnClick" AutomationProperties.Name="Voice settings" />
                            <Button Content="Shortcuts" Tag="SettingsShortcutsHeading" Style="{StaticResource BooNavButton}" Click="SettingsNav_OnClick" AutomationProperties.Name="Shortcut settings" />
                            <Button Content="Appearance" Tag="AppearanceHeading" Style="{StaticResource BooNavButton}" Click="SettingsNav_OnClick" AutomationProperties.Name="Appearance settings" />
                            <TextBlock Text="WORK" Foreground="{DynamicResource BooMuted}" FontSize="9" FontWeight="Bold" Margin="10,10,0,4" />
                            <Button Content="Task folder" Tag="SettingsTaskFolderHeading" Style="{StaticResource BooNavButton}" Click="SettingsNav_OnClick" AutomationProperties.Name="Task folder settings" />
                            <Button Content="AI and keys" Tag="SettingsAiHeading" Style="{StaticResource BooNavButton}" Click="SettingsNav_OnClick" AutomationProperties.Name="AI and keys settings" />
                            <Button Content="Updates" Tag="SettingsUpdatesHeading" Style="{StaticResource BooNavButton}" Click="SettingsNav_OnClick" AutomationProperties.Name="Update settings" />
                            <TextBlock x:Name="VersionLine" Text="Boo" Foreground="{DynamicResource BooMuted}" FontSize="9" Margin="10,14,0,0" />
                        </StackPanel>

                        <controls:BooSection x:Name="SettingsSection" Grid.Column="1" AutomationProperties.Name="Settings"
                                             Background="Transparent" Padding="0" Margin="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock x:Name="SettingsHeading" Text="Settings" Foreground="{DynamicResource BooText}" FontFamily="{StaticResource BooRounded}"
                                                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,2" AutomationProperties.HeadingLevel="Level2" />
                                        <TextBlock Text="How Boo behaves on your PC." Foreground="{DynamicResource BooMuted}" FontSize="11" Margin="0,0,0,8" />
                                        <TextBlock x:Name="ShortcutStatusText" Visibility="Collapsed" Foreground="{DynamicResource BooDanger}"
                                                   FontFamily="{StaticResource BooFont}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                                   AutomationProperties.AutomationId="ShortcutStatusText"
                                                   AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}" />

                                        <!-- General -->
                                        <TextBlock x:Name="SettingsGeneralHeading" Text="General" Style="{StaticResource BooGroupLabel}" AutomationProperties.HeadingLevel="Level3" />
                                        <Border Style="{StaticResource BooGroupCard}">
                                            <StackPanel>
                                                <CheckBox x:Name="StartWithWindowsBox" Content="Start Boo with Windows" Foreground="{DynamicResource BooText}"
                                                          FontFamily="Segoe UI" Margin="0,0,0,8" AutomationProperties.Name="Start Boo with Windows" />
                                                <CheckBox x:Name="ReducedMotionBox" Content="Reduced motion" Foreground="{DynamicResource BooText}" Margin="0,0,0,8"
                                                          AutomationProperties.Name="Reduce motion" />
                                                <CheckBox x:Name="ChirpMute" Content="Mute chirps" Foreground="{DynamicResource BooText}"
                                                          FontFamily="{StaticResource BooFont}" Margin="0,0,0,8" AutomationProperties.Name="Mute listening chirps" />
                                                <TextBlock Text="Display" Style="{StaticResource BooFieldLabel}" />
                                                <ComboBox x:Name="DisplayBox" Height="30" Margin="0,3,0,8" AutomationProperties.Name="Selected display"
                                                          SelectionChanged="DisplayBox_OnSelectionChanged" />
                                                <TextBlock Text="Notch offset from the top" Style="{StaticResource BooFieldLabel}" />
                                                <Slider x:Name="OffsetSlider" Minimum="-30" Maximum="120" Value="0" TickFrequency="5" IsSnapToTickEnabled="True"
                                                        SmallChange="5" LargeChange="20" Margin="0,3,0,2"
                                                        AutomationProperties.Name="Notch vertical offset"
                                                        AutomationProperties.HelpText="Pixels to move the notch down from the top edge. Arrow keys change it by 5." />
                                            </StackPanel>
                                        </Border>

                                        <!-- Voice and microphone -->
                                        <TextBlock x:Name="SettingsVoiceHeading" Text="Voice and microphone" Style="{StaticResource BooGroupLabel}" AutomationProperties.HeadingLevel="Level3" />
                                        <Border Style="{StaticResource BooGroupCard}">
                                            <StackPanel>
                                                <CheckBox x:Name="SpeechMute" Content="Mute spoken replies" Foreground="{DynamicResource BooText}"
                                                          FontFamily="{StaticResource BooFont}" Margin="0,0,0,8" AutomationProperties.Name="Mute spoken replies" />
                                                <TextBlock Text="Microphone" Style="{StaticResource BooFieldLabel}" />
                                                <ComboBox x:Name="MicrophoneBox" Height="30" Margin="0,3,0,6" AutomationProperties.Name="Selected microphone" />
                                                <TextBlock x:Name="VoiceLatencyText" Text="Voice latency: no warm hold-to-talk turns yet."
                                                           Foreground="{DynamicResource BooMuted}" FontFamily="Segoe UI" FontSize="10" TextWrapping="Wrap"
                                                           AutomationProperties.Name="Voice latency diagnostics" />
                                                <TextBlock Text="Voice always uses OpenAI Realtime and the OpenAI key."
                                                           Foreground="{DynamicResource BooMuted}" FontFamily="{StaticResource BooFont}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Shortcuts (fixed for now; the status line above says when one could not be registered) -->
                                        <TextBlock x:Name="SettingsShortcutsHeading" Text="Shortcuts" Style="{StaticResource BooGroupLabel}" AutomationProperties.HeadingLevel="Level3" />
                                        <Border Style="{StaticResource BooGroupCard}">
                                            <StackPanel>
                                                <TextBlock Text="Open Boo · Ctrl+Alt+B" Style="{StaticResource BooLabel}" FontSize="12" Margin="0,0,0,4" />
                                                <TextBlock Text="Hold to talk · Ctrl+Alt+Space" Style="{StaticResource BooLabel}" FontSize="12" Margin="0,0,0,4" />
                                                <TextBlock Text="Pause everything · Ctrl+Alt+S or Ctrl+Alt+F12" Style="{StaticResource BooLabel}" FontSize="12" Margin="0,0,0,4" />
                                                <TextBlock Text="Inside the panel: Ctrl+1 Home, Ctrl+2 Chat, Ctrl+3 Settings, F6 cycles views, Esc closes."
                                                           Foreground="{DynamicResource BooMuted}" FontSize="10" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Eyes (appearance) -->
                                        <TextBlock x:Name="AppearanceHeading" Text="Appearance" Style="{StaticResource BooGroupLabel}" AutomationProperties.HeadingLevel="Level3" />
                                        <Border Style="{StaticResource BooGroupCard}">
                                            <StackPanel>
                                                <TextBlock Text="Body color (#RRGGBB)" Style="{StaticResource BooFieldLabel}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,5">
                                                    <TextBox x:Name="BodyColorBox" Width="120" Height="30" Style="{StaticResource BooTextBox}" Margin="0"
                                                             AutomationProperties.Name="Notch body color" />
                                                    <Button x:Name="BodyColorButton" Content="Choose" AutomationProperties.Name="Choose notch body color"
                                                            Click="BodyColorButton_OnClick" Style="{StaticResource BooButton}" FontSize="11" Padding="8,4" Margin="7,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="Eye color (#RRGGBB)" Style="{StaticResource BooFieldLabel}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,5">
                                                    <TextBox x:Name="EyeColorBox" Width="120" Height="30" Style="{StaticResource BooTextBox}" Margin="0"
                                                             AutomationProperties.Name="Notch eye color" />
                                                    <Button x:Name="EyeColorButton" Content="Choose" AutomationProperties.Name="Choose notch eye color"
                                                            Click="EyeColorButton_OnClick" Style="{StaticResource BooButton}" FontSize="11" Padding="8,4" Margin="7,0,0,0" />
                                                </StackPanel>
                                                <TextBlock x:Name="AppearanceValidationText" Visibility="Collapsed" Foreground="{DynamicResource BooDanger}"
                                                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
                                                           AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                                                           AutomationProperties.LiveSetting="Polite" />
                                                <Button x:Name="ResetAppearanceButton" Content="_Reset appearance" ToolTip="Reset notch appearance (Alt+R)" AutomationProperties.Name="Reset notch appearance"
                                                        Click="ResetAppearanceButton_OnClick" Style="{StaticResource BooButton}" FontSize="11" Padding="8,4" HorizontalAlignment="Left" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Task folder -->
                                        <TextBlock x:Name="SettingsTaskFolderHeading" Text="Task folder" Style="{StaticResource BooGroupLabel}" AutomationProperties.HeadingLevel="Level3" />
                                        <Border Style="{StaticResource BooGroupCard}">
                                            <StackPanel>
                                                <TextBlock Text="Boo can only edit files inside this folder." Foreground="{DynamicResource BooMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBox x:Name="FileRootBox" Width="220" Height="30" Style="{StaticResource BooTextBox}" Margin="0"
                                                             AutomationProperties.Name="Selected task folder" ToolTip="Boo can only operate inside this user-selected folder" />
                                                    <Button x:Name="BrowseFolderButton" Content="Choose" AutomationProperties.Name="Choose task folder"
                                                            Click="BrowseFolderButton_OnClick" Style="{StaticResource BooButton}" FontSize="11" Padding="8,4" Margin="7,0,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- AI and keys -->
                                        <TextBlock x:Name="SettingsAiHeading" Text="AI and keys" Style="{StaticResource BooGroupLabel}" AutomationProperties.HeadingLevel="Level3" />
                                        <Border Style="{StaticResource BooGroupCard}">
                                            <StackPanel>
                                                <TextBlock Text="Text AI provider" Style="{StaticResource BooFieldLabel}" />
                                                <ComboBox x:Name="TextProviderBox" Height="30" Margin="0,3,0,5" AutomationProperties.Name="Text AI provider">
                                                    <ComboBoxItem Content="OpenAI" />
                                                    <ComboBoxItem Content="Anthropic Claude" />
                                                    <ComboBoxItem Content="Google Gemini" />
                                                </ComboBox>
                                                <TextBlock Text="Claude model (explain, research)" Style="{StaticResource BooFieldLabel}" />
                                                <TextBox x:Name="AnthropicModelBox" Height="30" Margin="0,3,0,5" Style="{StaticResource BooTextBox}"
                                                         AutomationProperties.Name="Claude model" />
                                                <TextBlock Text="Claude focus model" Style="{StaticResource BooFieldLabel}" />
                                                <TextBox x:Name="AnthropicFocusModelBox" Height="30" Margin="0,3,0,5" Style="{StaticResource BooTextBox}"
                                                         AutomationProperties.Name="Claude focus model" />
                                                <TextBlock Text="Gemini model (explain, research)" Style="{StaticResource BooFieldLabel}" />
                                                <TextBox x:Name="GeminiModelBox" Height="30" Margin="0,3,0,5" Style="{StaticResource BooTextBox}"
                                                         AutomationProperties.Name="Gemini model" />
                                                <TextBlock Text="Gemini focus model" Style="{StaticResource BooFieldLabel}" />
                                                <TextBox x:Name="GeminiFocusModelBox" Height="30" Margin="0,3,0,5" Style="{StaticResource BooTextBox}"
                                                         AutomationProperties.Name="Gemini focus model" />
                                                <TextBlock Text="OpenAI key (voice + OpenAI text)" Style="{StaticResource BooFieldLabel}" />
                                                <PasswordBox x:Name="CredentialBox" Height="28" Margin="0,3,0,8" AutomationProperties.Name="Provider credential masked input" />
                                                <TextBlock Text="Anthropic Claude key" Style="{StaticResource BooFieldLabel}" />
                                                <PasswordBox x:Name="AnthropicCredentialBox" Height="28" Margin="0,3,0,8" AutomationProperties.Name="Anthropic Claude key masked input" />
                                                <TextBlock Text="Google Gemini key" Style="{StaticResource BooFieldLabel}" />
                                                <PasswordBox x:Name="GeminiCredentialBox" Height="28" Margin="0,3,0,8" AutomationProperties.Name="Google Gemini key masked input" />
                                                <TextBlock Text="Screenshots and microphone audio are memory-only by default. Provider processing is separate from local retention."
                                                           Foreground="{DynamicResource BooMuted}" FontFamily="{StaticResource BooFont}" FontSize="10" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Updates -->
                                        <TextBlock x:Name="SettingsUpdatesHeading" Text="Updates" Style="{StaticResource BooGroupLabel}" AutomationProperties.HeadingLevel="Level3" />
                                        <Border Style="{StaticResource BooGroupCard}" Margin="0,0,0,4">
                                            <StackPanel>
                                                <CheckBox x:Name="UpdatesEnabledBox" Content="Check GitHub Releases for updates once a day" Foreground="{DynamicResource BooText}"
                                                          FontFamily="{StaticResource BooFont}" Margin="0,0,0,6"
                                                          AutomationProperties.Name="Check for updates automatically" />
                                                <CheckBox x:Name="UpdatesPrereleaseBox" Content="Include pre-releases" Foreground="{DynamicResource BooText}"
                                                          FontFamily="{StaticResource BooFont}" Margin="0,0,0,6"
                                                          AutomationProperties.Name="Include pre-release updates" />
                                                <TextBlock Text="GitHub token for the private Boo repository (read-only)" Style="{StaticResource BooFieldLabel}" />
                                                <PasswordBox x:Name="UpdateTokenBox" Height="28" Margin="0,3,0,3" AutomationProperties.Name="GitHub update token masked input" />
                                                <TextBlock x:Name="UpdateTokenHint" Text="No GitHub token saved." Foreground="{DynamicResource BooMuted}"
                                                           FontFamily="{StaticResource BooFont}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,5" />
                                                <WrapPanel Margin="0,0,0,5">
                                                    <Button x:Name="CheckUpdatesButton" Content="Check for updates" AutomationProperties.Name="Check for updates now"
                                                            Click="CheckUpdatesButton_OnClick" Style="{StaticResource BooButton}" FontSize="11" Padding="8,4" />
                                                    <Button x:Name="InstallUpdateButton" Content="Install and restart" Visibility="Collapsed" AutomationProperties.Name="Install update and restart Boo"
                                                            Click="InstallUpdateButton_OnClick" Style="{StaticResource BooButton}" FontSize="11" Padding="8,4" />
                                                </WrapPanel>
                                                <TextBlock x:Name="UpdateStatusLine" Text="Updates have not been checked yet." Foreground="{DynamicResource BooMuted}"
                                                           FontFamily="{StaticResource BooFont}" FontSize="11" TextWrapping="Wrap"
                                                           AutomationProperties.AutomationId="UpdateStatusLine"
                                                           AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                                                           AutomationProperties.LiveSetting="Polite" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                                <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                    <Button x:Name="SaveSettingsButton" Content="_Save settings" ToolTip="Save Boo settings (Alt+S)" AutomationProperties.Name="Save Boo settings"
                                            Click="SaveSettingsButton_OnClick" Style="{StaticResource BooPrimaryButton}" />
                                </WrapPanel>
                            </Grid>
                        </controls:BooSection>
                    </Grid>
                </Grid>

                <TextBlock Grid.Row="2" x:Name="StatusText" Text="Ready" Foreground="{DynamicResource BooMuted}"
                           FontFamily="{StaticResource BooFont}" FontSize="10" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="28" Margin="16,0,16,8"
                           AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
                           AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </Border>
    </Grid>
</Window>
