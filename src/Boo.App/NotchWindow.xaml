<Window x:Class="Boo.App.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" Title="Boo launcher"
        AutomationProperties.Name="Open Boo companion"
        MouseEnter="NotchWindow_OnMouseEnter" MouseLeave="NotchWindow_OnMouseLeave">
    <!--
        Face lane (U1/U2). Everything visible here is built from docs/design/boo-notch-spec.json
        (embedded resource, chosen face). Fully transparent pixels are click-through at the OS level,
        so the window can stay at its maximum size: only the hover strip (alpha 1/255), the pocket
        and the disclosure catch the pointer. No text is drawn on the collapsed notch.
    -->
    <Canvas x:Name="Root" ClipToBounds="True"
            MouseRightButtonUp="NotchSurface_OnMouseRightButtonUp">
        <!-- Invisible hover strip (spec hoverStrip, DIP) at the top centre. -->
        <Rectangle x:Name="HoverStrip" Fill="#01000000" Canvas.Top="0" />

        <!-- Notch: pocket body + face. Translate = reveal slide / nudge shake; scale = reveal overshoot. -->
        <Canvas x:Name="NotchHost" Visibility="Collapsed">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="RevealScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="RevealTranslate" X="0" Y="0" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <Path x:Name="BodyPath" Fill="#000000" />

            <!-- Face parts are positioned in body coordinates; FaceLayer's Canvas.Left = body left. -->
            <Canvas x:Name="FaceLayer" IsHitTestVisible="False">
                <Canvas x:Name="LeftEye">
                    <Canvas.RenderTransform>
                        <ScaleTransform x:Name="LeftBlink" ScaleX="1" ScaleY="1" />
                    </Canvas.RenderTransform>
                    <Rectangle x:Name="LeftWhite" Fill="#FFFFFF" />
                    <Ellipse x:Name="LeftPupil" Fill="#000000" />
                    <Ellipse x:Name="LeftGlint" Fill="#FFFFFF" />
                    <Path x:Name="LeftHappy" Stroke="#FFFFFF" StrokeThickness="3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                </Canvas>
                <Canvas x:Name="RightEye">
                    <Canvas.RenderTransform>
                        <ScaleTransform x:Name="RightBlink" ScaleX="1" ScaleY="1" />
                    </Canvas.RenderTransform>
                    <Rectangle x:Name="RightWhite" Fill="#FFFFFF" />
                    <Ellipse x:Name="RightPupil" Fill="#000000" />
                    <Ellipse x:Name="RightGlint" Fill="#FFFFFF" />
                    <Path x:Name="RightHappy" Stroke="#FFFFFF" StrokeThickness="3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                </Canvas>

                <!-- State indicators (no text). Built and positioned in code inside the indicator slot. -->
                <Canvas x:Name="ListeningBars" Visibility="Collapsed" />
                <Canvas x:Name="ThinkingDots" Visibility="Collapsed" />
                <Ellipse x:Name="RecordDot" Fill="#FF3B30" Visibility="Collapsed" />
                <Canvas x:Name="PauseBars" Visibility="Collapsed" />
            </Canvas>

            <!-- Click opens the full window; press-and-hold raises EyesHeldChanged. Kept as a Button for UI Automation (Invoke). -->
            <Button x:Name="OpenButton" Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                    Focusable="False" Click="OpenButton_OnClick"
                    PreviewMouseLeftButtonDown="OpenButton_OnPreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="OpenButton_OnPreviewMouseLeftButtonUp"
                    LostMouseCapture="OpenButton_OnLostMouseCapture"
                    AutomationProperties.Name="Open Boo companion">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Canvas>

        <!-- Privacy disclosure (capture / microphone). Never shown on the collapsed notch. -->
        <Border x:Name="ActiveDisclosure" MinHeight="30" Padding="8,4"
                CornerRadius="9" BorderThickness="1" Visibility="Collapsed"
                Background="{x:Static SystemColors.WindowBrush}"
                BorderBrush="{x:Static SystemColors.ActiveBorderBrush}">
            <TextBlock x:Name="ActiveDisclosureText" TextWrapping="Wrap"
                       VerticalAlignment="Center" FontFamily="{StaticResource BooFont}" FontSize="11"
                       Foreground="{x:Static SystemColors.WindowTextBrush}"
                       AutomationProperties.Name="Boo activity disclosure"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>
    </Canvas>
</Window>
