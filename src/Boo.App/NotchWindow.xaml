<Window x:Class="Boo.App.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" Title="Boo launcher"
        AutomationProperties.Name="Open Boo companion"
        AutomationProperties.HelpText="Boo's notch. Keyboard: Ctrl+Alt+B opens Boo's window, hold Ctrl+Alt+Space to talk, Ctrl+Alt+S or Ctrl+Alt+F12 pauses everything."
        MouseEnter="NotchWindow_OnMouseEnter" MouseLeave="NotchWindow_OnMouseLeave">
    <!--
        Face lane (U1/U2), Living ink look (2026-11-12). Sizes come from docs/design/boo-notch-spec.json
        (embedded resource, chosen face D); shapes, moods and motion from Boo.Core LivingInk. Fully transparent pixels are click-through at the OS level,
        so the window can stay at its maximum size: only the hover strip (alpha 1/255), the pocket
        and the disclosure catch the pointer. No text is drawn on the collapsed notch.
    -->
    <Canvas x:Name="Root" ClipToBounds="True">
        <!-- Invisible hover strip (spec hoverStrip, DIP) at the top centre. -->
        <Rectangle x:Name="HoverStrip" Fill="#01000000" Canvas.Top="0" />

        <!-- Notch: pocket body + face. Translate = reveal slide / nudge shake; scale = reveal overshoot. -->
        <!-- Right-click Stop lives on the visible pocket only: a right-click on the invisible hover strip
             (e.g. on a browser tab under it) must not stop Boo. -->
        <Canvas x:Name="NotchHost" Visibility="Collapsed"
                MouseRightButtonUp="NotchSurface_OnMouseRightButtonUp">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="RevealScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="RevealTranslate" X="0" Y="0" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- Living ink: the blot (vector path, morphs between moods) and loose ink (blooms, drip, rising dots, splatters). -->
            <Canvas x:Name="InkLayer" IsHitTestVisible="False" />
            <Path x:Name="BodyPath" Fill="#0C0A09" />

            <!-- Face parts are positioned in body coordinates; FaceLayer's Canvas.Left = body left. -->
            <Canvas x:Name="FaceLayer" IsHitTestVisible="False">
                <Canvas x:Name="LeftEye">
                    <!-- Eye squash (mood scale) about the eye centre, then translate (gaze drift, bounce). Clip = eye shape. -->
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="LeftBlink" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="LeftShift" X="0" Y="0" />
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <Path x:Name="LeftWhite" Fill="#F7F4EE" />
                    <Ellipse x:Name="LeftPupil" Fill="#0C0A09" />
                    <Ellipse x:Name="LeftGlint" Fill="#FFFFFF" Opacity="0.85" />
                    <Rectangle x:Name="LeftLid" Fill="#0C0A09" Height="0" />
                </Canvas>
                <Path x:Name="LeftHappy" Stroke="#F7F4EE" StrokeThickness="3"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                <Canvas x:Name="RightEye">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="RightBlink" ScaleX="1" ScaleY="1" />
                            <TranslateTransform x:Name="RightShift" X="0" Y="0" />
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <Path x:Name="RightWhite" Fill="#F7F4EE" />
                    <Ellipse x:Name="RightPupil" Fill="#0C0A09" />
                    <Ellipse x:Name="RightGlint" Fill="#FFFFFF" Opacity="0.85" />
                    <Rectangle x:Name="RightLid" Fill="#0C0A09" Height="0" />
                </Canvas>
                <Path x:Name="RightHappy" Stroke="#F7F4EE" StrokeThickness="3"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />

                <!-- State indicators (no text). Built and positioned in code inside the indicator slot. -->
                <!-- Speaking: four cream ink bars on the right, timed with the voice level. -->
                <Canvas x:Name="SpeakingBars" Visibility="Collapsed" />
                <Ellipse x:Name="RecordRing" Fill="#E5484D" Visibility="Collapsed" />
                <Ellipse x:Name="RecordDot" Fill="#E5484D" Visibility="Collapsed" />
                <Border x:Name="StopSquare" Width="18" Height="18" CornerRadius="5" Visibility="Collapsed">
                    <Border x:Name="StopSquareInner" Width="7" Height="7" CornerRadius="1.5"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Caption (responding / nudge only): typed in, Nunito 13/18, never on the collapsed notch. -->
                <TextBlock x:Name="Caption" Visibility="Collapsed" FontFamily="{StaticResource BooFont}"
                           FontSize="13" LineHeight="18" LineStackingStrategy="BlockLineHeight"
                           TextWrapping="Wrap" TextTrimming="WordEllipsis" Opacity="0" />
            </Canvas>

            <!-- Click opens the full window; press-and-hold raises EyesHeldChanged. Kept as a Button for UI Automation (Invoke). -->
            <Button x:Name="OpenButton" Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                    Focusable="False" Click="OpenButton_OnClick"
                    PreviewMouseLeftButtonDown="OpenButton_OnPreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="OpenButton_OnPreviewMouseLeftButtonUp"
                    LostMouseCapture="OpenButton_OnLostMouseCapture"
                    AutomationProperties.Name="Open Boo companion"
                    AutomationProperties.HelpText="Keyboard: Ctrl+Alt+B opens Boo's window, hold Ctrl+Alt+Space to talk, Ctrl+Alt+S or Ctrl+Alt+F12 pauses everything.">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Nudge actions (studio "Back to it" / "5 min break"), above the open button so they get the click. -->
            <StackPanel x:Name="NudgeActions" Orientation="Horizontal" Visibility="Collapsed">
                <Button x:Name="NudgeBackButton" Click="NudgeBack_OnClick" Focusable="False" Cursor="Hand"
                        AutomationProperties.Name="Back to it"
                        AutomationProperties.HelpText="Resumes the focus session. Keyboard: Resume in Boo's window (Ctrl+Alt+B)." Margin="0,0,6,0">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Pill" CornerRadius="10" Padding="10,2,10,3" Background="{TemplateBinding Background}">
                                <TextBlock Text="Back to it" FontFamily="{StaticResource BooFont}" FontSize="12"
                                           Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="NudgeBreakButton" Click="NudgeBreak_OnClick" Focusable="False" Cursor="Hand"
                        AutomationProperties.Name="5 min break"
                        AutomationProperties.HelpText="Pauses the focus session for five minutes. Keyboard: Pause in Boo's window (Ctrl+Alt+B).">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border CornerRadius="10" Padding="10,2,10,3" Background="{TemplateBinding Background}">
                                <TextBlock Text="5 min break" FontFamily="{StaticResource BooFont}" FontSize="12"
                                           Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Canvas>

        <!-- Privacy disclosure (capture / microphone). Never shown on the collapsed notch. -->
        <Border x:Name="ActiveDisclosure" MinHeight="30" Padding="8,4"
                CornerRadius="9" BorderThickness="1" Visibility="Collapsed"
                Background="{x:Static SystemColors.WindowBrush}"
                BorderBrush="{x:Static SystemColors.ActiveBorderBrush}">
            <TextBlock x:Name="ActiveDisclosureText" TextWrapping="Wrap"
                       VerticalAlignment="Center" FontFamily="{StaticResource BooFont}" FontSize="11"
                       Foreground="{x:Static SystemColors.WindowTextBrush}"
                       AutomationProperties.Name="Boo activity disclosure"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>
    </Canvas>
</Window>
