<Window x:Class="Boo.App.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="220" Height="8" MinWidth="220" MaxWidth="220"
        ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" Title="Boo launcher"
        AutomationProperties.Name="Open Boo companion"
        MouseEnter="NotchWindow_OnMouseEnter" MouseLeave="NotchWindow_OnMouseLeave">
    <Border x:Name="NotchSurface" Background="#01000000" CornerRadius="24"
            MouseRightButtonUp="NotchSurface_OnMouseRightButtonUp">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="NotchBody" Grid.Row="0" Width="92" Height="44"
                    HorizontalAlignment="Center" VerticalAlignment="Top"
                    CornerRadius="22" Background="#000000" Visibility="Collapsed">
                <Grid>
                    <Ellipse x:Name="LeftEye" Width="10" Height="15" Fill="#FFFFFF"
                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="25,0,0,0" />
                    <Ellipse x:Name="RightEye" Width="10" Height="15" Fill="#FFFFFF"
                             HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,25,0" />
                </Grid>
            </Border>

            <Border x:Name="ActiveDisclosure" Grid.Row="1" MinHeight="34"
                    Margin="5,3,5,3" Padding="7,3" VerticalAlignment="Top"
                    CornerRadius="7" BorderThickness="1" Visibility="Collapsed"
                    Background="{x:Static SystemColors.WindowBrush}"
                    BorderBrush="{x:Static SystemColors.ActiveBorderBrush}">
                <TextBlock x:Name="ActiveDisclosureText" TextWrapping="Wrap"
                           VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="10"
                           Foreground="{x:Static SystemColors.WindowTextBrush}"
                           AutomationProperties.Name="Boo activity disclosure"
                           AutomationProperties.LiveSetting="Polite" />
            </Border>

            <Button x:Name="OpenButton" Grid.RowSpan="2"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                    Focusable="False" Click="OpenButton_OnClick"
                    AutomationProperties.Name="Open Boo companion">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
