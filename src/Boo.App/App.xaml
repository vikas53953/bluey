<Application x:Class="Boo.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <FontFamily x:Key="BooRounded">/Boo;component/Assets/fredoka.ttf#Fredoka</FontFamily>
        <SolidColorBrush x:Key="BooInk" Color="#171719" />
        <SolidColorBrush x:Key="BooPanel" Color="#202023" />
        <SolidColorBrush x:Key="BooPanelRaised" Color="#2A2A2E" />
        <SolidColorBrush x:Key="BooBorder" Color="#414146" />
        <SolidColorBrush x:Key="BooText" Color="#FAF8F4" />
        <SolidColorBrush x:Key="BooMuted" Color="#B8B4AE" />
        <SolidColorBrush x:Key="BooAccent" Color="#F3B59B" />
        <SolidColorBrush x:Key="BooAccentDark" Color="#A96E5C" />
        <SolidColorBrush x:Key="BooDanger" Color="#F18C87" />
        <SolidColorBrush x:Key="BooInput" Color="#29292D" />
        <SolidColorBrush x:Key="BooNotchBody" Color="#000000" />
        <SolidColorBrush x:Key="BooNotchEyes" Color="#FFFFFF" />
        <Style x:Key="BooButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{DynamicResource BooText}" />
            <Setter Property="Background" Value="{DynamicResource BooPanelRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BooBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource BooRounded}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BooPanelRaised}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BooAccent}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BooTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="{DynamicResource BooText}" />
            <Setter Property="Background" Value="{DynamicResource BooInput}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BooBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="BooLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource BooText}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Application.Resources>
</Application>
