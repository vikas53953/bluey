<Application x:Class="Boo.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:controls="clr-namespace:Boo.App.Controls"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Typography (spec chosen.typeface): Nunito 500-800 bundled (OFL, Assets/Nunito-OFL.txt), Segoe UI fallback. -->
        <FontFamily x:Key="BooFont">/Boo;component/Assets/#Nunito, Segoe UI</FontFamily>
        <FontFamily x:Key="BooRounded">/Boo;component/Assets/#Nunito, Segoe UI</FontFamily>
        <system:Double x:Key="BooCaptionSize">13</system:Double>
        <system:Double x:Key="BooCaptionLineHeight">18</system:Double>
        <system:Double x:Key="BooHeadingSize">26</system:Double>
        <SolidColorBrush x:Key="BooInk" Color="#171719" />
        <SolidColorBrush x:Key="BooPanel" Color="#202023" />
        <SolidColorBrush x:Key="BooPanelRaised" Color="#2A2A2E" />
        <SolidColorBrush x:Key="BooBorder" Color="#414146" />
        <SolidColorBrush x:Key="BooText" Color="#FAF8F4" />
        <SolidColorBrush x:Key="BooMuted" Color="#B8B4AE" />
        <SolidColorBrush x:Key="BooAccent" Color="#F3B59B" />
        <SolidColorBrush x:Key="BooAccentDark" Color="#A96E5C" />
        <SolidColorBrush x:Key="BooDanger" Color="#F18C87" />
        <SolidColorBrush x:Key="BooInput" Color="#29292D" />
        <SolidColorBrush x:Key="BooNotchBody" Color="#000000" />
        <SolidColorBrush x:Key="BooNotchEyes" Color="#FFFFFF" />
        <!-- Keyboard focus ring (WCAG 2.4.7/2.4.11): a 2 px accent outline, drawn only for keyboard focus.
             BooAccent maps to SystemColors.Highlight under High Contrast, so the ring follows the user's theme. -->
        <Style x:Key="BooFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" StrokeThickness="2" Stroke="{DynamicResource BooAccent}"
                                   RadiusX="8" RadiusY="8" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource BooFocusVisual}" />
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource BooFocusVisual}" />
        </Style>
        <Style TargetType="{x:Type Slider}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource BooFocusVisual}" />
        </Style>
        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource BooFocusVisual}" />
        </Style>
        <Style TargetType="{x:Type ListBox}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource BooFocusVisual}" />
        </Style>
        <!-- Sections (UIA Groups): the same rounded card the Borders drew before. -->
        <Style TargetType="{x:Type controls:BooSection}">
            <Setter Property="Background" Value="{DynamicResource BooPanel}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:BooSection}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BooButton" TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{DynamicResource BooText}" />
            <Setter Property="Background" Value="{DynamicResource BooPanelRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BooBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource BooRounded}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource BooFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BooPanelRaised}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BooAccent}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BooTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="{DynamicResource BooText}" />
            <Setter Property="Background" Value="{DynamicResource BooInput}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BooBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource BooFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource BooFocusVisual}" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BooAccent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BooLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource BooText}" />
            <Setter Property="FontFamily" Value="{StaticResource BooFont}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="BooCaption" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource BooFont}" />
            <Setter Property="FontSize" Value="{StaticResource BooCaptionSize}" />
            <Setter Property="LineHeight" Value="{StaticResource BooCaptionLineHeight}" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="BooHeading" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource BooText}" />
            <Setter Property="FontFamily" Value="{StaticResource BooFont}" />
            <Setter Property="FontSize" Value="{StaticResource BooHeadingSize}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Application.Resources>
</Application>
