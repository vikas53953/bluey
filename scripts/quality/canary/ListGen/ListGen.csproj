<Project Sdk="Microsoft.NET.Sdk">
  <!-- Roslyn helper for scripts/quality/banned_apis.py: expands banned-groups.txt into src/BannedSymbols.txt from the
       real reference packs, and checks which banned symbol each canary call binds to. Not shipped. -->
