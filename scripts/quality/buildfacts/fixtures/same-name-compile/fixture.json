{
  "bypass": "a same-name compile outside the solution stands in for a solution project's assembly, moved only by allowed SDK copies (PR #37 review)",
  "builds": [
    {
      "label": "build",
      "args": [
        "build",
        "Fix.slnx",
        "-c",
        "Release"
      ]
    },
    {
      "label": "publish",
      "args": [
        "publish",
        "App/App.csproj",
        "-c",
        "Release",
        "-o",
        "out"
      ]
