<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build-facts extractor for scripts/quality/build_facts.py: reads the binary logs of windows-ci's real Release build
       and publish and writes build-facts.json (what the compiler was really given, what was really imported and
       referenced, what really came out). Not shipped, not in Boo.sln. Packages are pinned exactly and locked
       (packages.lock.json, restored with locked mode in CI), so the reader itself is reproducible. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Stated here, not only in Directory.Build.props, so the tool means the same thing when built on its own. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Fixture projects live under fixtures/ and are built on their own; never compile them into the tool. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);fixtures/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="[5.6.0]" />
    <PackageReference Include="MSBuild.StructuredLogger" Version="[2.3.269]" />
  </ItemGroup>
</Project>
